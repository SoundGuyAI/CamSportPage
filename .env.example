# Default input mode. The UI's own picker (localStorage `camsport.inputMode`)
# overrides this at runtime; this only sets the initial/CI default.

# Stage 1: pointer + keyboard
# VITE_INPUT_MODE=pointer

# Stage 2 (shipped): webcam frame-difference swing detection + pointer fallback
# VITE_INPUT_MODE=camera

# Reserved for a future MediaPipe pose adapter (PoseInput is still a stub)
# VITE_INPUT_MODE=pose
